{
	"name": "bekci",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 5227 --strictPort",
		"build": "vite build",
		"preview": "node build.mjs pre && wrangler dev --port 5228",
		"deploy": "npm run check && npm test && wrangler deploy",
		"db:migrate": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"test": "vitest run",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260924.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^7.0.2",
		"vite": "^8.3.1",
		"vitest": "^5.0.1",
		"wrangler": "^4.138.0"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"@solana/web3.js": "^1.99.0",
		"bs58": "^6.0.0"
	}
}
