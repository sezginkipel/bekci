{
	// Build-time config for @sveltejs/adapter-cloudflare only. `main` points at the
	// adapter's own output so it never overwrites src/worker.ts; `assets` must be
	// present or the adapter assumes Pages and skips .assetsignore.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bekci",
	"compatibility_date": "2026-08-01",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": { "directory": ".svelte-kit/cloudflare", "binding": "ASSETS" }
}
